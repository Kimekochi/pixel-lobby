rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Лобби и общая галерея образов: читать и писать может любой, кто открыл сайт
    // (вход анонимный, без пароля). Для компании друзей этого достаточно.
    match /lobbies/{id} {
      allow read, write: if request.auth != null;
    }
    match /presets/{id} {
      allow read, create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.by == request.auth.uid;
    }
    // Личный профиль: только сам игрок
    match /data/users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
